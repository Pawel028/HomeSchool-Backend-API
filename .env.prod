# Production on Azure. Committed on purpose: contains NO secrets.
# JWT_SECRET, DB_PASSWORD, OTP_WEBHOOK_TOKEN come from Key Vault; DB_HOST, CORS_ORIGINS and OTP_WEBHOOK_URL are set by Terraform.
APP_ENV=prod
LOG_LEVEL=INFO
LOG_JSON=true

# CORS_ORIGINS=<set by Terraform: production admin console and site origins, never *>
TRUSTED_HOSTS=*

DB_PORT=5432
DB_NAME=homeschool
DB_USER=homeschool_app
DB_SSLMODE=require

# Real SMS delivery is required in production (the config validator refuses the console provider).
OTP_PROVIDER=webhook
EXPOSE_DEV_OTP=false
DECLARATION_NOTICE_VERSION=2026-09-draft

MIN_APP_VERSION=0.1.0
ENABLE_RECOMMENDATIONS=true
SEED_ON_STARTUP=false
