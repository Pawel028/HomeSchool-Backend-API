# Local development. Committed on purpose: contains NO secrets. Put local passwords in .env.local (git-ignored).
APP_ENV=dev
LOG_LEVEL=DEBUG
LOG_JSON=false

CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4280,http://localhost:3000
TRUSTED_HOSTS=*

DB_HOST=localhost
DB_PORT=5432
DB_NAME=homeschool
DB_USER=homeschool_app
DB_SSLMODE=prefer
# DB_PASSWORD and JWT_SECRET: see .env.local.example

OTP_PROVIDER=console
EXPOSE_DEV_OTP=true
DECLARATION_NOTICE_VERSION=2026-09-draft

MIN_APP_VERSION=0.1.0
ENABLE_RECOMMENDATIONS=true
SEED_ON_STARTUP=true
SEED_BUNDLE_PATH=seed/launch-bundle.json
