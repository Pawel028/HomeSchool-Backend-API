# Shared test environment on Azure (Container Apps, "nonprod"). Committed on purpose: contains NO secrets.
# Secrets (JWT_SECRET, DB_PASSWORD) and the URLs that only exist after deployment (CORS_ORIGINS, DB_HOST) are injected by
# Terraform as Container App environment variables / Key Vault references and override anything in this file.
APP_ENV=nonprod
LOG_LEVEL=INFO
LOG_JSON=true

# CORS_ORIGINS=<set by Terraform: the Static Web Apps host names for the nonprod admin console and site>
TRUSTED_HOSTS=*

DB_PORT=5432
DB_NAME=homeschool
DB_USER=homeschool_app
DB_SSLMODE=require

# The console provider writes the one-time code to the log so testers can read it from Log Analytics. Test data only.
OTP_PROVIDER=console
EXPOSE_DEV_OTP=false
DECLARATION_NOTICE_VERSION=2026-09-draft

MIN_APP_VERSION=0.1.0
ENABLE_RECOMMENDATIONS=true
SEED_ON_STARTUP=false
