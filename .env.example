# Every setting the API reads (see app/config.py). Real values live in the environment (Azure Container Apps / Key Vault).
APP_ENV=dev                      # dev | nonprod | prod | test  (selects .env.<APP_ENV>)
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=                    # comma separated, explicit origins in nonprod/prod
TRUSTED_HOSTS=*
DATABASE_URL=                    # optional; overrides the DB_* variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homeschool
DB_USER=homeschool_app
DB_PASSWORD=                     # secret
DB_SSLMODE=prefer                # require or verify-full in nonprod/prod
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
JWT_SECRET=                      # secret, at least 32 random characters in nonprod/prod
JWT_ISSUER=homeschool-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CHILD_TOKEN_MINUTES=60
ELEVATION_MINUTES=5
OTP_PROVIDER=console             # console | webhook | disabled
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=               # secret
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
EXPOSE_DEV_OTP=false             # true only for local development
DECLARATION_NOTICE_VERSION=2026-09-draft
MIN_APP_VERSION=0.1.0
ENABLE_RECOMMENDATIONS=true
SEED_ON_STARTUP=false
SEED_BUNDLE_PATH=
# Release job only (python -m app.cli release):
APP_DB_USER=homeschool_app
APP_DB_PASSWORD=                 # secret: password of the role the API connects as
